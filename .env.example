# Copia este archivo a .env (mismo directorio, junto a manage.py) y
# ajusta los valores. .env NUNCA se sube al repositorio (ver .gitignore).

DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-secreta-propia
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE = sqlite (por defecto, no requiere servidor) o mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Ejemplo de configuración para MySQL/MariaDB (sql/sgr_v5_modelo_relacional_completo.sql):
# DB_ENGINE=mysql
# DB_NAME=sgr_db
# DB_USER=sgr_user
# DB_PASSWORD=cambia-esta-contrasena
# DB_HOST=localhost
# DB_PORT=3306

# Correo de la recuperación de contraseña.
# Con EMAIL_HOST vacío el correo no se envía: aparece en la terminal donde corre "runserver".
# Para mandarlo de verdad completa estos datos en tu .env (por ejemplo, con un buzón de pruebas de
# Mailtrap: EMAIL_HOST=sandbox.smtp.mailtrap.io y EMAIL_PORT=2525). Las credenciales nunca se suben
# al repositorio: este archivo se queda con los valores en blanco.
DEFAULT_FROM_EMAIL=noreply@proyecto.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Solo con el puerto 465: EMAIL_USE_SSL=True (el TLS se apaga solo).

# ---------------------------------------------------------------------------------------------------------------
# Producción / AWS (todo opcional: sin estas variables el proyecto funciona igual que en tu computador).
# La plantilla completa para el servidor está en deploy/sgr.env.example y la guía en docs/aws/DESPLIEGUE_AWS.md.
# ---------------------------------------------------------------------------------------------------------------
# Con DEBUG=False hace falta una SECRET_KEY propia (el sistema no arranca con la de ejemplo).
# Dominio con HTTPS, separado por comas:  CSRF_TRUSTED_ORIGINS=https://sgr.ejemplo.cl
# CSRF_TRUSTED_ORIGINS=
# Detrás de nginx o de un balanceador: BEHIND_PROXY=True. Sitio completo por HTTPS: HTTPS=True
# BEHIND_PROXY=False
# HTTPS=False
# Archivos estáticos sin nginx:  USE_WHITENOISE=True  (después: python manage.py collectstatic)
# USE_WHITENOISE=False
# Caché de los intentos de recuperación: locmem (un proceso), redis (REDIS_URL) o db.
# CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1
