# Variables de entorno del SGR en AWS. Copia este archivo a /etc/sgr/sgr.env (permisos 600, dueño sgr) y completa los
# valores. NUNCA lo subas al repositorio ni lo pegues en las evidencias: tiene los secretos.

DJANGO_SETTINGS_MODULE=sgr_project.settings
DEBUG=False
# Genera una clave propia (solo letras, números, - y _, para que ningún programa la interprete mal):  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Dominio(s) o IP pública, separados por coma. Si usas balanceador, agrega también la IP privada de la instancia.
ALLOWED_HOSTS=
# Con HTTPS: https://tu-dominio (separados por coma). Sin esto, los formularios fallan con 403 (CSRF).
CSRF_TRUSTED_ORIGINS=

# Seguridad (activa estas tres cuando el sitio ya se sirva por HTTPS)
HTTPS=False
BEHIND_PROXY=True
SECURE_HSTS_SECONDS=0

# Archivos estáticos servidos por nginx (recomendado) o por WhiteNoise si no usas nginx
USE_WHITENOISE=False

# Base de datos: sqlite (por defecto) o mysql (RDS)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Caché compartida para los intentos de la recuperación de contraseña (obligatoria con más de un proceso)
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1

# Correo real de la recuperación (sin EMAIL_HOST el código sale por la consola del servicio)
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

LOG_LEVEL=INFO
