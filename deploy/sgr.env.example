DJANGO_SETTINGS_MODULE=sgr_project.settings
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

HTTPS=False
BEHIND_PROXY=True
SECURE_HSTS_SECONDS=0

USE_WHITENOISE=False

DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1

DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

LOG_LEVEL=INFO
