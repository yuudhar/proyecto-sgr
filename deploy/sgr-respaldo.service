[Unit]
Description=Respaldo de la base de datos y los archivos del SGR
After=network.target mariadb.service

[Service]
Type=oneshot
User=sgr
Group=sgr
WorkingDirectory=/opt/sgr/app
EnvironmentFile=/etc/sgr/sgr.env
ExecStart=/opt/sgr/venv/bin/python manage.py respaldar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sgr
UMask=0077
