# Variables del SGR en Amazon Linux 2023 (se copia a /etc/sgr/sgr.env con permisos 600, dueño sgr).
# instalar_al2023.sh completa solo SECRET_KEY, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS y DB_PASSWORD; https_certificado.sh
# cambia HTTPS y CSRF_TRUSTED_ORIGINS. NUNCA subas este archivo ya completo al repositorio ni lo muestres en las capturas.

DJANGO_SETTINGS_MODULE=sgr_project.settings
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Apache le pasa el tráfico a gunicorn. HTTPS pasa a True cuando ya hay certificado.
HTTPS=False
BEHIND_PROXY=True
SECURE_HSTS_SECONDS=0
USE_WHITENOISE=False

# MariaDB 10.11 o más (el usuario y la base se crean en phpMyAdmin)
DB_ENGINE=mysql
DB_NAME=sgr_django
DB_USER=sgr_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Un solo proceso de gunicorn con varios hilos: la caché local (locmem) sirve para contar los intentos de la
# recuperación de contraseña. Con más procesos hay que pasar a CACHE_BACKEND=redis (o db) y subir GUNICORN_WORKERS.
CACHE_BACKEND=locmem
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Correo real de la recuperación (sin EMAIL_HOST el código sale por el registro del servicio: journalctl -u sgr)
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

LOG_LEVEL=INFO

# Archivos que suben las personas (evidencias y fotos). Vacío = /opt/sgr/app/media. No se pierden al actualizar.
MEDIA_ROOT=
