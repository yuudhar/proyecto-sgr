[Unit]
Description=SGR (Django + Daphne: HTTP y WebSocket)
After=network.target

[Service]
User=sgr
Group=sgr
WorkingDirectory=/opt/sgr/app
EnvironmentFile=/etc/sgr/sgr.env
ExecStart=/opt/sgr/venv/bin/daphne -b 127.0.0.1 -p 8000 --proxy-headers --access-log - sgr_project.asgi:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sgr

[Install]
WantedBy=multi-user.target
