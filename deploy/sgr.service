# /etc/systemd/system/sgr.service
# Instala con: sudo cp deploy/sgr.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now sgr
[Unit]
Description=SGR (Django + gunicorn)
After=network.target

[Service]
User=sgr
Group=sgr
WorkingDirectory=/opt/sgr/app
EnvironmentFile=/etc/sgr/sgr.env
ExecStart=/opt/sgr/venv/bin/gunicorn -c deploy/gunicorn.conf.py sgr_project.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
# Endurecimiento básico del servicio
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sgr

[Install]
WantedBy=multi-user.target
